# Server-only ComfyUI endpoint. Never use a NEXT_PUBLIC_ variable here.
COMFY_BASE_URL=https://your-protected-comfyui-host.example/

# Optional, only when the protected endpoint requires a short-lived server cookie.
# Never commit a real cookie.
COMFY_AUTH_COOKIE=

# Four independent ComfyUI workers for the CLI action batch runner.
# These variables are server/CLI-only. Never rename them to NEXT_PUBLIC_*.
COMFY_GPU_1_URL=https://your-gpu-1-comfyui-host.example/
COMFY_GPU_2_URL=https://your-gpu-2-comfyui-host.example/
COMFY_GPU_3_URL=https://your-gpu-3-comfyui-host.example/
COMFY_GPU_4_URL=https://your-gpu-4-comfyui-host.example/

# Optional short-lived cookies. Keep real values in the process environment or
# an ignored local env file; the batch runner never writes them to run records.
COMFY_GPU_1_AUTH_COOKIE=
COMFY_GPU_2_AUTH_COOKIE=
COMFY_GPU_3_AUTH_COOKIE=
COMFY_GPU_4_AUTH_COOKIE=

# Durable action coordinator. The website talks only to this server-side URL;
# the browser never receives the token. Keep the known POC cache enabled until
# one explicitly approved four-GPU acceptance run.
PET_ACTION_COORDINATOR_URL=http://127.0.0.1:4317/
PET_ACTION_COORDINATOR_TOKEN=replace-with-a-long-random-secret
PET_ACTION_COORDINATOR_HOST=127.0.0.1
PET_ACTION_COORDINATOR_PORT=4317
PET_ACTION_USE_KNOWN_CACHE=true
