{
  "name": "paw-planet-action-poc",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "smooth:video": "bash scripts/smooth-pet-video.sh",
    "close:seam": "bash scripts/close-idle-seam.sh",
    "preview:feed": "bash scripts/build-feed-bowl-preview.sh",
    "pet:workflow": "node scripts/pet-action-workflow.mjs",
    "pet:batch": "node --experimental-strip-types scripts/run-pet-action-batch.ts",
    "pet:coordinator": "node --experimental-strip-types scripts/run-pet-action-coordinator.ts",
    "pet:finalize": "node --experimental-strip-types scripts/finalize-pet-video.ts",
    "test:branches": "node --experimental-strip-types --test lib/pet-action-branches.test.ts",
    "test:jobs": "node --experimental-strip-types --test lib/pet-avatar-jobs.test.ts",
    "test:coordinator": "node --experimental-strip-types --test lib/pet-action-coordinator.test.ts scripts/pet-action-coordinator.test.ts",
    "test:worker-pool": "node --experimental-strip-types --test lib/comfy/worker-pool.test.ts",
    "test:workflow": "node --test scripts/pet-action-workflow.test.mjs",
    "test:video": "node --experimental-strip-types --test lib/video/pet-video-finalizer.test.ts",
    "test": "npm run test:branches && npm run test:jobs && npm run test:coordinator && npm run test:workflow && npm run test:worker-pool && npm run test:video"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
